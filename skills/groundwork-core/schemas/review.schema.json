{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundwork/review/1.0",
  "title": "Independent reviewer output",
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocker",
            "minor"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
          }
        },
        "suggested_fix": {
          "type": "string"
        },
        "resolution": {
          "enum": [
            "open",
            "fixed",
            "accepted_minor",
            "exception_requested",
            "needs_person"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "severity",
        "target",
        "what",
        "evidence_ids",
        "suggested_fix",
        "resolution"
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "view_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "surface": {
      "enum": [
        "claude-code-local",
        "claude-code-cloud",
        "claude-app"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "subagent",
        "fresh_conversation"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "not_performed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_hash",
    "surface",
    "model",
    "mode",
    "findings",
    "not_performed"
  ]
}
