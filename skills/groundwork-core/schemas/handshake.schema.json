{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundwork/handshake/1.0",
  "title": "Groundwork skill handshake",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^groundwork-[a-z0-9-]+$",
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "system",
        "tracker"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "kind",
    "version",
    "release",
    "contract",
    "platform"
  ]
}
