{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundwork/plan/1.0",
  "title": "Groundwork plan",
  "$defs": {
    "compat": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "accepted",
            "accepted_with_note",
            "refused"
          ]
        },
        "verified": {
          "enum": [
            "verified",
            "unverified",
            "mismatch"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "skill",
        "result",
        "verified",
        "notes"
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocker",
            "minor"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
          }
        },
        "suggested_fix": {
          "type": "string"
        },
        "resolution": {
          "enum": [
            "open",
            "fixed",
            "accepted_minor",
            "exception_requested",
            "needs_person"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "severity",
        "target",
        "what",
        "evidence_ids",
        "suggested_fix",
        "resolution"
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P\\d+-T\\d{2,}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "pattern": "^gw:gw-[0-9A-HJKMNP-TV-Z]{26}:P\\d+-T\\d{2,}$"
        },
        "phase": {
          "type": "string",
          "pattern": "^P\\d+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "work_type": {
          "enum": [
            "story",
            "task"
          ]
        },
        "kind": {
          "enum": [
            "setup",
            "design",
            "build",
            "config",
            "data",
            "test",
            "uat",
            "cutover",
            "rollback",
            "docs",
            "training",
            "comms",
            "signoff_prep",
            "handoff",
            "spike",
            "measurement",
            "reconciliation"
          ]
        },
        "role_key": {
          "anyOf": [
            {
              "enum": [
                "developer",
                "admin",
                "analyst",
                "qa",
                "business_user",
                "trainer",
                "comms",
                "maintainer",
                "approver",
                "legal",
                "finance",
                "procurement",
                "security",
                "vendor_contact",
                "facilitator"
              ]
            },
            {
              "type": "string",
              "pattern": "^x-[a-z0-9_]+$"
            }
          ]
        },
        "points": {
          "const": 1
        },
        "estimate_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "parallel_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string",
                "pattern": "^P\\d+-T\\d{2,}$"
              },
              "satisfied_by": {
                "enum": [
                  "done",
                  "merged",
                  "deployed"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "task",
              "satisfied_by"
            ]
          }
        },
        "waits_on": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "approval",
                  "review",
                  "merge",
                  "vendor",
                  "job",
                  "access",
                  "availability",
                  "elapsed",
                  "external_event"
                ]
              },
              "owner_role_key": {
                "anyOf": [
                  {
                    "enum": [
                      "developer",
                      "admin",
                      "analyst",
                      "qa",
                      "business_user",
                      "trainer",
                      "comms",
                      "maintainer",
                      "approver",
                      "legal",
                      "finance",
                      "procurement",
                      "security",
                      "vendor_contact",
                      "facilitator"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9_]+$"
                  }
                ]
              },
              "condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "legacy_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "what",
              "kind",
              "owner_role_key"
            ]
          }
        },
        "access": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A\\d+$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
          }
        },
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "type",
              "name"
            ]
          }
        },
        "instructions": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "from_evidence": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lang": {
                    "type": "string",
                    "pattern": "^[a-z0-9+#-]+$"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "text",
                  "refs",
                  "from_evidence"
                ]
              }
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verify": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "done_today": {
              "type": "string",
              "minLength": 1
            },
            "cautions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "purpose",
            "prerequisites",
            "steps",
            "acceptance_criteria",
            "verify",
            "done_today"
          ]
        },
        "visible_result": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "pr_opened",
                "merged_pr",
                "deployed_change",
                "record_created",
                "record_updated",
                "doc_submitted",
                "comment_posted",
                "document",
                "decision_record",
                "measurement"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        "production_change": {
          "type": "boolean"
        },
        "data_change": {
          "type": "boolean"
        },
        "test_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P\\d+-T\\d{2,}$"
          }
        },
        "rollback_task": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^P\\d+-T\\d{2,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "exception": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "days": {
                  "type": "integer",
                  "minimum": 2
                },
                "checkpoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "visible_result": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "day",
                      "visible_result"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "reason",
                "days",
                "checkpoints"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "object",
          "properties": {
            "pattern": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules_checked": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "pattern",
            "rules_checked"
          ]
        },
        "changes_existing": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^R\\d+$"
                  },
                  "minItems": 1
                },
                "why_needed": {
                  "type": "string",
                  "minLength": 1
                },
                "could_break": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "regression_check": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^P\\d+-T\\d{2,}$"
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "resources",
                "why_needed",
                "could_break",
                "regression_check"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "brief_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^B-\\d+$"
          }
        },
        "approach_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AD-\\d+$"
          }
        },
        "derived_from_rec": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^REC-\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy_action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "enum": [
                    "close",
                    "split",
                    "update",
                    "sequence"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "ref",
                "action"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "key",
        "phase",
        "title",
        "work_type",
        "kind",
        "role_key",
        "points",
        "estimate_hours",
        "parallel_group",
        "depends_on",
        "waits_on",
        "access",
        "evidence_refs",
        "produces",
        "instructions",
        "visible_result",
        "production_change",
        "data_change",
        "test_tasks",
        "rollback_task",
        "exception",
        "origin",
        "changes_existing"
      ]
    },
    "stamps": {
      "type": "object",
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "plan_format": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "verified": {
                "enum": [
                  "verified",
                  "unverified",
                  "mismatch"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "verified"
            ]
          }
        },
        "overlay": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "format": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "hash",
            "format"
          ]
        },
        "validator": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "surface": {
          "enum": [
            "claude-code-local",
            "claude-code-cloud",
            "claude-app"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "compat": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compat"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "release",
        "core",
        "contract",
        "plan_format",
        "skills",
        "overlay",
        "validator",
        "surface",
        "model",
        "compat"
      ]
    },
    "brief_field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B-\\d+$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "answered",
            "not_applicable",
            "open"
          ]
        },
        "na_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "open_question": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^Q-\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^P\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "runner",
            "role_confirmed",
            "evidence",
            "from_tracker",
            "pasted"
          ]
        },
        "basis_role_key": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "enum": [
                    "developer",
                    "admin",
                    "analyst",
                    "qa",
                    "business_user",
                    "trainer",
                    "comms",
                    "maintainer",
                    "approver",
                    "legal",
                    "finance",
                    "procurement",
                    "security",
                    "vendor_contact",
                    "facilitator"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^x-[a-z0-9_]+$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitivity": {
          "enum": [
            "normal",
            "restricted"
          ]
        },
        "value_rev": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value",
        "status",
        "na_reason",
        "open_question",
        "phase",
        "source",
        "basis_role_key",
        "derived_from",
        "sensitivity",
        "value_rev"
      ]
    },
    "approach": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^O-\\d+$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "reuse_extend",
                  "smaller",
                  "do_nothing",
                  "new",
                  "other"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
                }
              },
              "not_inspected_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pros": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rejected_because": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "brief_ref": {
                        "type": "string",
                        "pattern": "^B-\\d+$"
                      },
                      "why": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "brief_ref",
                      "why"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "summary",
              "kind",
              "evidence",
              "not_inspected_reason",
              "pros",
              "cons",
              "rejected_because"
            ]
          },
          "minItems": 2
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AD-\\d+$"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "chosen_option": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^O-\\d+$"
                  },
                  {
                    "const": "deferred"
                  }
                ]
              },
              "deferred_to_task": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^P\\d+-T\\d{2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "brief_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^B-\\d+$"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*-[0-9a-f]{8}$"
                }
              },
              "trait_conflict": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(x-)?[a-z][a-z0-9_]*$"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "decision",
              "chosen_option",
              "deferred_to_task",
              "brief_refs",
              "evidence"
            ]
          },
          "minItems": 1
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R\\d+$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "options",
        "decisions",
        "unchanged"
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^gw-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "proposed",
        "active",
